<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lkrjangid.account_manager">

    <!-- ── Permissions ───────────────────────────────────────────────────── -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        AUTHENTICATE_ACCOUNTS / MANAGE_ACCOUNTS are deprecated since API 22
        but still required for the authenticator binding on older devices.
        On API 23+ the system grants these automatically to the package that
        owns the authenticator.
    -->
    <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
    <uses-permission android:name="android.permission.MANAGE_ACCOUNTS" />
    <!--
        GET_ACCOUNTS requires runtime grant on API 26+.
        The plugin calls getAccountsByType() which only returns accounts owned
        by this authenticator, so no extra runtime permission is needed for that.
    -->
    <uses-permission android:name="android.permission.GET_ACCOUNTS" />

    <application>

        <!--
            AddAccountActivity
            ══════════════════
            Launched by Android when the user taps:
              Settings → Accounts → Add account → Account Manager

            android:exported="true" is mandatory — Settings starts this Activity
            from outside the app's process.
        -->
        <activity
            android:name=".authenticator.AddAccountActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar"
            android:label="@string/account_manager_label" />

        <!--
            AuthenticatorService
            ════════════════════
            Bound by AccountManager framework to reach our AccountAuthenticator.
            Must respond to android.accounts.AccountAuthenticator intent.
        -->
        <service
            android:name=".authenticator.AuthenticatorService"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accounts.AccountAuthenticator" />
            </intent-filter>
            <meta-data
                android:name="android.accounts.AccountAuthenticator"
                android:resource="@xml/authenticator" />
        </service>

    </application>

</manifest>
